{
  "name": "ekko-studio-plugin-travel",
  "version": "0.5.2",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "ekko-studio plugins dev .",
    "harness:check": "node scripts/plugin-harness.mjs check",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run harness:check && npm test && npm run build --if-present && npm run harness:check",
    "check": "npm run harness:check && npm test",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@ekko-studio/plugin-sdk": "file:./sdk",
    "@playwright/test": "1.60.0"
  },
  "description": "找旅游攻略，查酒店、火车票和机票。输入地址或经纬度，规划公交、驾车或步行路线。",
  "author": "ekko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EKKOLearnAI/ekko-studio-plugin-travel.git"
  },
  "engines": {
    "node": ">=22"
  }
}
