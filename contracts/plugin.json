    "tool-collection": {
      "type": "object",
      "description": "采集工具回传。",
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "业务是否获得可用结果。"
        },
        "content": {
          "type": "string",
          "description": "状态说明。",
          "maxLength": 2000
        },
        "data": {
          "type": "object",
          "description": "一次固定脚本采集的结果，状态和记录完整校验。",
          "properties": {
            "schemaVersion": {
              "type": "integer",
              "description": "结果结构版本。",
              "enum": [
                1
              ]
            },
            "source": {
              "type": "string",
              "description": "来源标识。",
              "enum": [
                "ctrip",
                "xiaohongshu",
                "meituan",
                "ctrip-guide",
                "mafengwo"
              ]
            },
            "tabId": {
              "type": "string",
              "description": "此次采集的宿主标签页 ID。",
              "maxLength": 200
            },
            "url": {
              "type": "string",
              "description": "经清理的 HTTPS 来源地址；不返回平台会话参数。",
              "maxLength": 4096
            },
            "pageTitle": {
              "type": "string",
              "description": "页面标题。",
              "maxLength": 500
            },
            "collectedAt": {
              "type": "integer",
              "description": "采集时间，Unix 毫秒。",
              "minimum": 0
            },
            "status": {
              "type": "string",
              "description": "ok 正文；partial 不完整信息；其他状态明确说明未取到数据的原因。",
              "enum": [
                "ok",
                "partial",
                "login_required",
                "verification_required",
                "blocked",
                "loading",
                "empty",
                "layout_changed"
              ]
            },
            "message": {
              "type": "string",
              "description": "可读的状态说明。",
              "maxLength": 1000
            },
            "records": {
              "type": "array",
              "description": "有效数据；失败时为空。",
              "items": {
                "type": "object",
                "description": "清洗后的旅游记录，不包含推断的实时房态、日期或套餐条件。",
                "properties": {
                  "kind": {
                    "type": "string",
                    "description": "hotel 酒店卡片；deal 团购卡片；guide 完整正文；guide_link 列表摘要。",
                    "enum": [
                      "hotel",
                      "deal",
                      "guide",
                      "guide_link"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "description": "标题或酒店名称。",
                    "maxLength": 300
                  },
                  "url": {
                    "type": "string",
                    "description": "经清理的 HTTPS 来源地址；不返回平台会话参数。",
                    "maxLength": 4096
                  },
                  "text": {
                    "type": "string",
                    "description": "正文或卡片摘要；列表链接可为空。",
                    "maxLength": 20000
                  },
                  "images": {
                    "type": "array",
                    "description": "正文中的图片 URL；尚未执行 OCR。",
                    "items": {
                      "type": "string",
                      "description": "经清理的 HTTPS 来源地址；不返回平台会话参数。",
                      "maxLength": 4096
                    },
                    "maxItems": 12
                  },
                  "price": {
                    "type": "object",
                    "description": "页面价格原文与可确定的金额。未知金额省略 amountMinor/currency。",
                    "properties": {
                      "raw": {
                        "type": "string",
                        "description": "价格原文；未找到时为空。",
                        "maxLength": 300
                      },
                      "basis": {
                        "type": "string",
                        "description": "starting 起价；conditional 条件价；total 总价；per_night 每晚价；unknown 未知口径。",
                        "enum": [
                          "unknown",
                          "starting",
                          "conditional",
                          "total",
                          "per_night"
                        ]
                      },
                      "amountMinor": {
                        "type": "integer",
                        "description": "人民币分，必须是明确的单一正金额。",
                        "minimum": 1,
                        "maximum": 100000000
                      },
                      "currency": {
                        "type": "string",
                        "description": "币种，只解析明确人民币符号。",
                        "enum": [
                          "CNY"
                        ]
                      }
                    },
                    "required": [
                      "raw",
                      "basis"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "kind",
                  "title",
                  "url",
                  "text",
                  "images",
                  "price"
                ],
                "additionalProperties": false
              },
              "maxItems": 40
            },
            "warnings": {
              "type": "array",
              "description": "信息缺失和使用边界。",
              "items": {
                "type": "string",
                "description": "单条说明。",
                "maxLength": 1000
              },
              "maxItems": 20
            },
            "diagnostics": {
              "type": "object",
              "description": "用于本地核对的有限诊断，不写入公开仓库。",
              "properties": {
                "readyState": {
                  "type": "string",
                  "description": "浏览器加载状态。",
                  "enum": [
                    "loading",
                    "interactive",
                    "complete"
                  ]
                },
                "matchedBlocks": {
                  "type": "integer",
                  "description": "匹配到的卡片数。",
                  "minimum": 0
                },
                "matchedLinks": {
                  "type": "integer",
                  "description": "匹配到的原文链接数。",
                  "minimum": 0
                },
                "articleCharacters": {
                  "type": "integer",
                  "description": "读取到的正文字符数。",
                  "minimum": 0
                },
                "excerpt": {
                  "type": "string",
                  "description": "可见页面文本的有限片段，非表单输入。",
                  "maxLength": 1600
                }
              },
              "required": [
                "readyState",
                "matchedBlocks",
                "matchedLinks",
                "articleCharacters",
                "excerpt"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "schemaVersion",
            "source",
            "tabId",
            "url",
            "pageTitle",
            "collectedAt",
            "status",
            "message",
            "records",
            "warnings",
            "diagnostics"
          ],
          "additionalProperties": false
        },
        "error": {
          "type": "string",
          "description": "工具错误说明。",
          "maxLength": 1000
        }
      },
      "required": [
        "ok",
        "content"
      ],
      "additionalProperties": false
    }
  },
