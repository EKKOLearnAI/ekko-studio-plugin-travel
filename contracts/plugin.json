          "type": "boolean",
          "description": "业务是否获得可用结果。"
        },
        "content": {
          "type": "string",
          "description": "状态说明。",
          "maxLength": 2000
        },
        "data": {
          "type": "object",
          "description": "支持来源的标签页集合。",
